<?xml version="1.0" encoding="utf-8"?>
<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="DGUV-OPER-PR-HistoMibiUntersuchung" />
  <url value="http://fhir.dguv.de/OPER/Observation/DGUV-OPER-PR-HistoMibiUntersuchung" />
  <version value="0.1" />
  <name value="DGUV_OPER_PR_HistoMibiUntersuchung" />
  <title value="Histo -/mikrobiologische Untersuchung" />
  <status value="draft" />
  <publisher value="Deutsche Gesetzliche Unfallversicherung e.V. (DGUV)" />
  <description value="Hier werden die histologischen bzw. mikrobiologischen Untersuchungen angegeben." />
  <fhirVersion value="4.0.1" />
  <kind value="resource" />
  <abstract value="false" />
  <type value="Observation" />
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Observation" />
  <derivation value="constraint" />
  <differential>
    <element id="Observation">
      <path value="Observation" />
      <short value="Hier können die Informationen zur veranlassten histologischen und mikrobiologischen Untersuchung hinterlegt werden" />
      <constraint>
        <key value="dguv-HistoMibi-1" />
        <severity value="error" />
        <human value="Wurde eine histol./mikrob. Untersuchung veranlasst (boolean = true), dann muss auch eine freitextl. Untersuchungsbeschreibung (value) existieren." />
        <expression value="extension.where(url = 'http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-HistoMibiUntersuchungVeranlasst').valueBoolean.first() = true implies valueString.exists()" />
      </constraint>
      <constraint>
        <key value="dguv-HistoMibi-2" />
        <severity value="error" />
        <human value="Wurde KEINE histol./mikrob. Untersuchung veranlasst (boolean = false), dann darf auch KEINE freitextl. Untersuchungsbeschreibung (value) existieren." />
        <expression value="extension.where(url = 'http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-HistoMibiUntersuchungVeranlasst').valueBoolean.first() = false implies valueString.exists().not()" />
      </constraint>
    </element>
    <element id="Observation.id">
      <path value="Observation.id" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.meta">
      <path value="Observation.meta" />
      <min value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.meta.profile">
      <path value="Observation.meta.profile" />
      <slicing>
        <discriminator>
          <type value="value" />
          <path value="$this" />
        </discriminator>
        <rules value="open" />
      </slicing>
      <min value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.meta.profile:operProfile">
      <path value="Observation.meta.profile" />
      <sliceName value="operProfile" />
      <min value="1" />
      <max value="1" />
      <fixedCanonical value="http://fhir.dguv.de/OPER/Observation/DGUV-OPER-PR-HistoMibiUntersuchung" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.extension">
      <path value="Observation.extension" />
      <min value="1" />
      <max value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.extension:HistoMibiUntersuchungVeranlasst">
      <path value="Observation.extension" />
      <sliceName value="HistoMibiUntersuchungVeranlasst" />
      <min value="1" />
      <type>
        <code value="Extension" />
        <profile value="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-HistoMibiUntersuchungVeranlasst" />
      </type>
      <mustSupport value="true" />
      <isModifier value="false" />
    </element>
    <element id="Observation.extension:HistoMibiUntersuchungVeranlasst.value[x]">
      <path value="Observation.extension.value[x]" />
      <comment value="Wenn „true“ eingetragen ist, muss in Observation.value[x] zwingend eine Beschreibung der veranlassten histologischen oder mikrobiologischen Untersuchungen angegeben werden." />
      <mustSupport value="true" />
    </element>
    <element id="Observation.partOf">
      <path value="Observation.partOf" />
      <min value="1" />
      <max value="1" />
      <type>
        <code value="Reference" />
        <targetProfile value="http://fhir.dguv.de/OPER/Procedure/DGUV-OPER-PR-OPProzedur" />
      </type>
      <mustSupport value="true" />
    </element>
    <element id="Observation.partOf.reference">
      <path value="Observation.partOf.reference" />
      <min value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.status">
      <path value="Observation.status" />
      <fixedCode value="final" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.code">
      <path value="Observation.code" />
      <short value="Kennzeichnung des OPER-Observationprofiltyps" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.code.coding">
      <path value="Observation.code.coding" />
      <min value="1" />
      <max value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.code.coding.system">
      <path value="Observation.code.coding.system" />
      <short value="CodeSystem für OPER-Observationprofiltypen" />
      <min value="1" />
      <fixedUri value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-Teilberichtsinhalt" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.code.coding.code">
      <path value="Observation.code.coding.code" />
      <short value="Kürzel des OPER-Observationprofiltyps" />
      <min value="1" />
      <fixedCode value="HMUN" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.code.coding.display">
      <path value="Observation.code.coding.display" />
      <short value="Bezeichnung des OPER-Observationprofiltyps" />
      <min value="1" />
      <fixedString value="HistologischeMikrobiologischeUntersuchung" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.subject">
      <path value="Observation.subject" />
      <min value="1" />
      <type>
        <code value="Reference" />
        <targetProfile value="http://fhir.dguv.de/OPER/Patient/DGUV-OPER-PR-VersichertePerson" />
      </type>
      <mustSupport value="true" />
    </element>
    <element id="Observation.subject.reference">
      <path value="Observation.subject.reference" />
      <min value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Observation.value[x]">
      <path value="Observation.value[x]" />
      <short value="Freitext zu veranlassten histologischen und mikrobiologischen Untersuchungen" />
      <definition value="Hier können die Informationen zur veranlassten histologischen und mikrobiologischen Untersuchung hinterlegt werden. Die Beschreibung muss insbesondere auch die Art des Untersuchungsmaterials (histologisch und/oder mikrobiologisch) enthalten." />
      <type>
        <code value="string" />
      </type>
      <mustSupport value="true" />
    </element>
  </differential>
</StructureDefinition>