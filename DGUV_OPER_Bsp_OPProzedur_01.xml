<?xml version="1.0" encoding="UTF-8"?>
<!--
 Author: KE, Claude
 Datum: 16.09.2026

 Die vorliegende Beispiel-Datei "DGUV_OPER_Bsp_OPProzedur_01.xml" basiert auf
 "DGUV_OPER_Bsp_OPProzedur_00.xml" und dient der Validierung folgenden Szenarios:

 P: Wie Basisdatei _00 (Maximalbefüllung aller MustSupport-Attribute), jedoch mit
    angepasster Extension "Narkose": Die Bindung von Extension.value[x] erfolgt
    nun an das ValueSet "DGUV-OPER-VS-Narkose-SNOMED" (Eingrenzung auf SNOMED CT)
    statt wie zuvor an das eigene CodeSystem "DGUV-OPER-CS-Narkose".

 ### ÄNDERUNG GEGENÜBER _00 ###
 Betroffen ist ausschließlich die Extension "Narkose" (siehe Markierung
 "### GEÄNDERT ###" weiter unten). Alle übrigen Attribute/Extensions
 (Schnittzeit, Nahtzeit, OP-Befund/-verlauf, OPS-Code mit KBV-Seitigkeit,
 SNOMED-Code, Fallnummer, OP-Zeitpunkt, OP-Grund, Körperstelle, Nachbehandlung,
 Implantat mit SNOMED-Seitigkeit) sind unverändert gegenüber der Basisdatei
 und nutzen bereits zuvor bestehende CodeSystems/ValueSets (SNOMED, KBV, OPS).
-->

<Procedure xmlns="http://hl7.org/fhir">
  <!--Meta-Daten-->
  <id value="opProzedur-02"/>
  <meta>
    <profile value="http://fhir.dguv.de/OPER/Procedure/DGUV-OPER-PR-OPProzedur"/>
  </meta>

  <!--Narrativ-->
  <text>
    <status value="generated" />
      <div xmlns="http://www.w3.org/1999/xhtml">
      <h1>Hier finden Sie ein Beispiel der OPProzedur einer verunfallten Person.</h1>
      </div>
  </text>

  <!-- ### GEÄNDERT ### Narkoseform/-bezeichnung
       Vorher: system = http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-Narkose, Code "LA"
       Jetzt:  Bindung von Extension.value[x] an ValueSet
               http://fhir.dguv.de/OPER/ValueSet/DGUV-OPER-VS-Narkose-SNOMED
               (grenzt SNOMED CT ein) -> system = http://snomed.info/sct -->
  <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-Narkose">
    <valueCodeableConcept>
      <coding>
        <!-- ### GEÄNDERT ### system: SNOMED CT statt eigenes DGUV-CodeSystem -->
        <system value="http://snomed.info/sct"/>
        <!-- ### GEÄNDERT ### code/display: SNOMED-Code statt DGUV-Code "LA" -->
        <code value="386761002"/>
        <display value="Lokalanästhesie"/>
      </coding>
      <text value="Drei Tropfen auf die Haut"/>
    </valueCodeableConcept>
  </extension>

  <!--Schnittzeit (unverändert)-->
  <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-Schnittzeit">
    <valueDateTime value="2026-02-25T09:15:00+01:00"/>
  </extension>

  <!--Nahtzeit (unverändert)-->
  <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-Nahtzeit">
    <valueDateTime value="2026-02-25T10:05:00+01:00"/>
  </extension>

  <!--OP-Befund und Verlauf (unverändert)-->
  <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-OPBefundVerlauf">
    <valueString value="Intraoperativer Befund: Krank. Keine Komplikationen. Verlauf regelrecht."/>
  </extension>

  <!--Status der Prozedur (unverändert)-->
  <status value="completed"/>

  <!--OP-Prozedur (OPS, SNOMED und Freitext) (unverändert - nutzte bereits SNOMED/KBV)-->
  <code>
    <coding>
      <extension url="http://fhir.de/StructureDefinition/seitenlokalisation">
        <valueCoding>
          <system value="https://fhir.kbv.de/CodeSystem/KBV_CS_SFHIR_ICD_SEITENLOKALISATION"/>
          <code value="R"/>
          <display value="rechts"/>
        </valueCoding>
      </extension>
      <system value="http://fhir.de/CodeSystem/bfarm/ops"/>
      <code value="5-470"/>
      <display value="Appendektomie"/>
    </coding>
    <coding>
      <system value="http://snomed.info/sct"/>
      <code value="80146002"/>
      <display value="Appendectomy"/>
    </coding>
    <text value="Exzision des Wurmfortsatzes"/>
  </code>

  <!--Verunfallte Person (unverändert)-->
  <subject>
    <reference value="urn:uuid:482bb42d-a37b-45f7-8893-0abe669bd8ba"/>
  </subject>

  <!--Fallnummer (unverändert)-->
  <encounter>
    <identifier>
      <value value="FALL-2026-000123"/>
    </identifier>
  </encounter>

  <!--OP-Datum (unverändert)-->
  <performedDateTime value="2026-02-25"/>

  <!--OP-Indikation (unverändert)-->
  <reasonCode>
    <text value="Starke Schmerzen im rechten Unterbauch. Wurmfortsatz stark entzündet."/>
  </reasonCode>

  <!--Körperstelle (unverändert - nutzte bereits SNOMED)-->
  <bodySite>
    <coding>
      <system value="http://snomed.info/sct"/>
      <code value="66754008"/>
      <display value="Appendix structure (body structure)"/>
    </coding>
    <text value="Appendix" />
  </bodySite>

  <!--Hinweise zur Nachbehandlung (unverändert)-->
  <followUp>
    <text value="Teilbelastung für 6 Wochen, anschließend schrittweiser Belastungsaufbau."/>
  </followUp>

  <!--Referenz auf Implantat (unverändert - nutzte bereits SNOMED-Seitigkeit)-->
  <focalDevice>
    <manipulated>
      <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-Seitenlokalisation">
        <valueCoding>
          <system value="http://snomed.info/sct"/>
          <code value="419465000"/>
          <display value="Unilateral right"/>
        </valueCoding>
      </extension>
      <reference value="urn:uuid:implantat-001"/>
    </manipulated>
  </focalDevice>
</Procedure>
