<?xml version="1.0" encoding="UTF-8"?>
<!--
 Author: AFW
 Datum: 26.02.2026

 Die vorliegende Beispiel-Datei "DGUV_OPER_Bsp_Composition_02.xml" dient der Validierung
 folgenden Szenarios:
 

N: Diese Datei enthält bewusst fehlerhafte Elemente innerhalb einer FHIR Composition
    gemäß DGUV-OPER-Profil. Ziel ist es, typische Validierungsfehler zu demonstrieren
    und Testfälle für die Prüfung von Struktur, Pflichtfeldern, Kardinalitäten,
    Code-Systemen sowie Referenzen bereitzustellen. Die enthaltenen Fehler decken
    unter anderem fehlende Pflichtangaben, falsche Codes, ungültige Werteformate
    und unvollständige Abschnittsstrukturen ab.

-->
<Composition xmlns="http://hl7.org/fhir">

  <!-- FEHLER 1: ID fehlt komplett (optional erlaubt, aber meist mustSupport → Testfall) -->

  <meta>
    <profile value="http://fhir.dguv.de/OPER/Composition/DGUV-OPER-PR-Composition" />
  </meta>

  <!-- FEHLER 3: falscher status (muss 'final' sein laut Profil) -->
  <status value="preliminary" />

  <!-- FEHLER 4: coding.code falsch (muss 'OPER' sein) -->
  <type>
    <coding>
      <system value="http://fhir.dguv.de/Basis/CodeSystem/DGUV-Basis-CS-Formtexte"/>
      <code value="WRONG"/>
      <display value="Falscher Bericht"/>
    </coding>
  </type>

  <!-- FEHLER 5: subject fehlt komplett (Pflichtfeld) -->

  <!-- FEHLER 6: falsches Datumsformat -->
  <date value="2025/11/02" />

  <!-- FEHLER 7: mehrere Autoren obwohl max=1 -->
  <author>
    <reference value="urn:uuid:author-1"/>
  </author>
  <author>
    <reference value="urn:uuid:author-2"/>
  </author>

  <!-- FEHLER 8: falscher Titel -->
  <title value="Falscher Titel" />

  <!-- SECTION: Unfallereignis -->
  <section>
    <code>
      <coding>
        <!-- FEHLER 9: falsches Code-System -->
        <system value="http://wrong.system"/>
        <!-- FEHLER 10: falscher Code -->
        <code value="XXXX"/>
        <display value="Unfallereignis"/>
      </coding>
    </code>
    <!-- FEHLER 11: entry fehlt -->
  </section>

  <!-- SECTION: Unfallversicherungsträger -->
  <!-- FEHLER 12: komplette Section fehlt → Pflicht laut Profil -->

  <!-- SECTION: Diagnosen -->
  <section>
    <code>
      <coding>
        <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-CompositionSections"/>
        <code value="DGNS"/>
        <display value="Diagnosen"/>
      </coding>
    </code>

    <!-- FEHLER 13: Untersection fehlt komplett (mindestens 1 erforderlich) -->

  </section>

  <!-- SECTION: OP-Daten -->
  <section>
    <code>
      <coding>
        <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-CompositionSections"/>
        <code value="OPDT"/>
        <display value="OP-Daten"/>
      </coding>
    </code>

    <!-- FEHLER 14: zu wenige Untersektionen (min 3 gefordert) -->
    <section>
      <code>
        <coding>
          <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-CompositionSections"/>
          <code value="OPBV"/>
          <display value="OP-Befund und -Verlauf"/>
        </coding>
      </code>
      <!-- FEHLER 15: entry fehlt -->
    </section>

  </section>

  <!-- SECTION: PostoperativeTherapieempfehlung -->
  <section>
    <code>
      <coding>
        <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-CompositionSections"/>
        <code value="POTE"/>
        <display value="Postoperative Therapieempfehlung"/>
      </coding>
    </code>

    <!-- FEHLER 16: falscher Referenztyp -->
    <entry>
      <reference value="http://example.org/WrongResource/123"/>
    </entry>
  </section>

  <!-- SECTION: Behandelnde Einrichtung -->
  <section>
    <code>
      <coding>
        <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-CompositionSections"/>
        <code value="BNEN"/>
        <display value="Behandelnde Einrichtung"/>
      </coding>
    </code>

    <!-- FEHLER 17: fehlender entry.reference -->
    <entry/>
  </section>

</Composition>