<?xml version="1.0" encoding="UTF-8"?>
<!-- 
 Author: AFW
 Datum: 13.03.2026
 
 Die vorliegende Beispiel-Datei "DGUV_OPER_Bsp_HistoMibiUntersuchung_01.xml" dient der Validierung
 folgenden Szenarios (Standardfall):
 
 P: Maximalbefüllung einer Instanz HistoMibiUntersuchung (Meta-Daten, Untersuchungsveranlassung: ja, Verweis auf OP-Prozedur, Status, Teilberichtsinhalt,
    Verunfallte Person, Freitextbeschreibung veranlasster HistoMibiUntersuchung: Constr. "dguv-HistoMibi-1" erfüllt)
-->
<Observation xmlns="http://hl7.org/fhir">

  <!--Meta-Daten-->
  <id value="histoMibiUntersuchung-01"/>
  <meta>
    <profile value="http://fhir.dguv.de/OPER/Observation/DGUV-OPER-PR-HistoMibiUntersuchung"/>
  </meta>
  
  <!-- Pflicht-Extension: Untersuchung veranlasst -->
  <extension url="http://fhir.dguv.de/OPER/Extension/DGUV-OPER-EX-HistoMibiUntersuchungVeranlasst">
    <valueBoolean value="true"/>
  </extension>

    <!-- Bezug zur OP-Prozedur -->
   <partOf>
    <reference value="Procedure/OP-67890"/>
  </partOf>
  
  <!--Status-->
  <status value="final"/>

  <!-- Kodierung laut Profil: Teilberichtsinhalt -->
  <code>
    <coding>
      <system value="http://fhir.dguv.de/OPER/CodeSystem/DGUV-OPER-CS-Teilberichtsinhalt"/>
      <code value="HMUN"/>
      <display value="HistologischeMikrobiologischeUntersuchung"/>
    </coding>
  </code>

  <!-- Referenz auf die versicherte Person-->
  <subject>
    <reference value="http://fhir.dguv.de/OPER/Patient/482bb42d-a37b-45f7-8893-0abe669bd8ba"/>
  </subject> 

  <!--Freitextbeschreibung der veranlassten histologischen und mikrobiologischen Untersuchung(en) -->
  <valueString value="Es wurde ein 1,2 cm großes Gewebefragment aus dem entzündlich veränderten Weichteilbereich der rechten Unterarmregion entnommen. Das Material wurde zur histologischen Beurteilung der Gewebearchitektur sowie zur mikrobiologischen Diagnostik (Bakterien-, Pilz- und Resistenzenachweis) eingesandt"/>
  
</Observation>